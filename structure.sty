% 5.0 Chapter 标题格式
% ctexbook 默认编号行 (Chapter 1) 用 \huge，标题行用 \Huge，差一号。
% 这里统一为 \Huge，使编号与标题字号一致。
\ctexset{
    chapter = {
        nameformat = \Huge \bfseries,
    },
    part = {
        nameformat = \Huge \bfseries,
    }
}

% 5.1 Section 格式设置
\titleformat{\section}
{\normalfont\Large\bfseries\raggedright}
{\thesection}
{1em}
{}
\titlespacing{\section}{0pt}{*3.5}{*1.5}

% 5.2 页眉页脚设置
\pagestyle{fancy}
\fancyhf{} % 清除所有默认设置
\fancyfoot[C]{\thepage} % 页码置于底部中间
\renewcommand{\headrulewidth}{0pt} % 去掉页眉横线

