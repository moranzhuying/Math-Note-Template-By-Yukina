\usepackage[most]{tcolorbox}

% --- 0. 清理可能冲突的环境 ---
\let\comment\relax
\let\endcomment\relax
\let\problem\relax
\let\answer\relax
\let\hint\relax
\let\endhint\relax
\let\sketch\relax
\let\proof\relax
\let\endproof\relax
\let\algorithm\relax
\let\endalgorithm\relax
\let\code\relax
\let\endcode\relax
\let\convention\relax
\let\endconvention\relax
\let\alarm\relax
\let\endalarm\relax

% --- 1. 颜色体系定义 (高区分度学术配色) ---
% 颜色均适合作为白色背景上的标题和顶边线；盒子背景使用对应颜色的浅色混合。
\definecolor{mainblue}{RGB}{25, 95, 170}       % 蓝：定义
\definecolor{mainindigo}{RGB}{65, 75, 160}     % 靛蓝：公理/元定理
\definecolor{mainteal}{RGB}{0, 125, 140}       % 青：假设/问题
\definecolor{mainred}{RGB}{180, 45, 55}        % 红：定理/警告
\definecolor{mainorange}{RGB}{210, 100, 25}    % 橙：引理/算法
\definecolor{mainpurple}{RGB}{115, 70, 155}    % 紫：命题/分析
\definecolor{maingreen}{RGB}{40, 125, 75}      % 绿：推论/例
\definecolor{mainbrown}{RGB}{145, 90, 45}      % 茶：准则/约定
\definecolor{mainyellow}{RGB}{195, 135, 0}     % 黄：提示/注意
\definecolor{maingray}{RGB}{80, 80, 80}        % 灰：证明/回答/注记/代码
\definecolor{lightgray}{RGB}{245, 245, 245}    % 浅灰背景

% 统一计数器
\newcounter{mathcount}[chapter]
\renewcommand{\themathcount}{\thechapter.\arabic{mathcount}}

% --- 2. 通用基础样式 ---
\tcbset{
	base_thmstyle/.style={
		enhanced, breakable, sharp corners, boxrule=0pt, frame hidden,
		attach title to upper={\par\nopagebreak\smallskip},
		fonttitle=\bfseries\sffamily,
		description font=\bfseries\sffamily,
		separator sign={.},
		label separator={},
		description delimiters={}{},
		left=2pt, right=2pt, top=8pt, bottom=5pt,
		before skip=1.5em, after skip=1.5em,
	},
	accent north/.style={borderline north={1.8pt}{0pt}{#1}},
	accent west/.style={borderline west={1.8pt}{0pt}{#1}}
}

% --- 3. 核心理论环境 (使用 tcbtheorem，带编号) ---

% 基础陈述：蓝、靛蓝、青
\newtcbtheorem[use counter=mathcount, number within=chapter]{definition}{定义}{
base_thmstyle, label type=definition, colback=mainblue!6!white, accent north=mainblue, coltitle=mainblue }{}
\newtcbtheorem[use counter from=definition]{axiom}{公理}{
base_thmstyle, label type=axiom, colback=mainindigo!7!white, accent north=mainindigo, coltitle=mainindigo }{}
\newtcbtheorem[use counter from=definition]{hypothesis}{假设}{
base_thmstyle, label type=hypothesis, colback=mainteal!7!white, accent north=mainteal, coltitle=mainteal }{}

% 推演结果：每类使用独立主色，便于快速辨认
\newtcbtheorem[use counter from=definition]{theorem}{定理}{
base_thmstyle, label type=theorem, colback=mainred!6!white, accent north=mainred, coltitle=mainred }{}
\newtcbtheorem[use counter from=definition]{lemma}{引理}{
base_thmstyle, label type=lemma, colback=mainorange!8!white, accent north=mainorange, coltitle=mainorange }{}
\newtcbtheorem[use counter from=definition]{proposition}{命题}{
base_thmstyle, label type=proposition, colback=mainpurple!7!white, accent north=mainpurple, coltitle=mainpurple }{}
\newtcbtheorem[use counter from=definition]{corollary}{推论}{
base_thmstyle, label type=corollary, colback=maingreen!7!white, accent north=maingreen, coltitle=maingreen }{}
\newtcbtheorem[use counter from=definition]{metatheorem}{元定理}{
	base_thmstyle, label type=metatheorem, colback=mainindigo!7!white, accent north=mainindigo, coltitle=mainindigo }{}
\newtcbtheorem[use counter from=definition]{criteria}{准则}{
base_thmstyle, label type=criteria, colback=mainbrown!8!white, accent north=mainbrown, coltitle=mainbrown }{}

% 补充说明：问题、例、注记
\newtcbtheorem[use counter from=definition]{problem}{问题}{
base_thmstyle, label type=problem, colback=mainyellow!8!white, accent north=mainyellow, coltitle=mainbrown }{}
\newtcbtheorem[use counter from=definition]{example}{例}{
base_thmstyle, label type=example, colback=maingreen!6!white, accent north=maingreen, coltitle=maingreen }{}
\newtcbtheorem[use counter from=definition]{remark}{注记}{
base_thmstyle, label type=remark, colback=maingray!6!white, accent north=maingray, coltitle=maingray }{}

% 新增环境：算法、约定、警示（均与定理环境共用编号）
\newtcbtheorem[use counter from=definition]{algorithm}{算法}{
base_thmstyle, label type=algorithm, colback=mainorange!8!white, accent north=mainorange, coltitle=mainorange }{}
\newtcbtheorem[use counter from=definition]{convention}{约定}{
base_thmstyle, label type=convention, colback=mainbrown!8!white, accent north=mainbrown, coltitle=mainbrown }{}
\newtcbtheorem[use counter from=definition]{alarm}{警示}{
base_thmstyle, label type=alarm, colback=mainyellow!16!white, accent north=mainred, coltitle=mainred }{}

% --- 4. 证明与回答环境 (通常不带章节编号，但样式统一) ---

% 灰色顶线:证明,回答,分析
\newtcolorbox{proof}{
	base_thmstyle,
	title={证明},
	coltitle=maingray,
	accent north=maingray!50,
	colback=white,
	after upper={\hfill $\square$} % 自动加证明完毕符号
}

\newtcolorbox{answer}{
	base_thmstyle,
	title={回答},
	coltitle=maingray,
	accent north=maingray!30,
	colback=white!2!white
}

\newtcbtheorem[use counter from=definition]{sketch}{分析}{
base_thmstyle, label type=sketch, colback=mainpurple!5!white, accent north=mainpurple!70, coltitle=mainpurple }{}

% --- 5. 提示环境：环境正文可自然换行、分段和跨页 ---
\newtcolorbox{hint}[1][提示]{
	base_thmstyle,
	title={#1},
	coltitle=mainbrown,
	colback=mainyellow!10!white,
	accent west=mainyellow,
	left=8pt,
	top=5pt
}

% --- 6. 代码环境：可换行、可跨页；可选参数作为标题 ---
% 用法：\begin{code}[Python 示例] ... \end{code}
\newtcblisting{code}[1][]{
	enhanced, breakable, listing only,
	sharp corners, boxrule=0pt, frame hidden,
	colback=maingray!6!white,
	accent west=maingray,
	title={\ifstrempty{#1}{代码}{代码：#1}},
	fonttitle=\bfseries\sffamily,
	coltitle=maingray,
	left=8pt, right=5pt, top=5pt, bottom=5pt,
	before skip=1.5em, after skip=1.5em,
	listing options={
		basicstyle=\ttfamily\small,
		breaklines=true,
		columns=fullflexible,
		keepspaces=true,
		showstringspaces=false
	}
}



