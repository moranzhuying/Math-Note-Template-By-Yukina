% 6.1 定义新的定理风格 (note)
\newtheoremstyle{note}
{3pt}          % 上方间距
{3pt}          % 下方间距
{\normalfont}  % 正文字体
{}             % 缩进
{\bfseries}    % 标题字体
{.}            % 标题后标点
{ }            % 标题与正文间距
{}             % 标题格式

% 6.2 证明 (proof) 环境重定义
% 注意：此处假设你已经定义了 myproof 环境，如果没有，请确保定义它
\RenewDocumentEnvironment{proof}{o}{%
	\IfNoValueTF{#1}
	{\begin{myproof}}
		{\begin{myproof}[#1]}%
		}{%
		\end{myproof}%
	}

	

